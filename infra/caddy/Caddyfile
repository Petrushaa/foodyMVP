{$DOMAIN_NAME} {
    encode gzip

    request_body {
        max_size 20MB
    }

    # R13-S1/B4 security headers (HSTS + clickjacking + MIME-sniff defence + leak cleanup)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(self), camera=(), microphone=()"
        # Скрываем x-powered-by из Next.js
        -X-Powered-By
        -Server
    }

    # Django static
    handle_path /static/* {
        root * /var/www/static
        file_server
    }

    # Django media
    handle_path /media/* {
        root * /var/www/media
        file_server
    }

    # NextAuth → frontend (важно: до /api/*)
    handle /api/auth/* {
        reverse_proxy frontend:3000 {
            # CVE-2025-29927: заголовок позволяет обойти auth-middleware Next.js —
            # срезаем его от клиентов до проксирования
            header_up -X-Middleware-Subrequest
        }
    }

    # Django API
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Django admin
    handle /admin/* {
        reverse_proxy backend:8000
    }

    # Next.js (всё остальное)
    handle {
        reverse_proxy frontend:3000 {
            # CVE-2025-29927: см. блок /api/auth/* выше
            header_up -X-Middleware-Subrequest
        }
    }

    handle_errors {
        @413 expression {http.error.status_code} == 413
        handle @413 {
            header Content-Type "application/json"
            respond `{"error":"payload_too_large","message":"Файл превышает лимит 20 МБ.","status":413}` 413
        }
        @5xx expression {http.error.status_code} >= 500
        handle @5xx {
            header Content-Type "application/json"
            respond `{"error":"server_error","message":"Внутренняя ошибка сервера.","status":{http.error.status_code}}` {http.error.status_code}
        }
    }
}
