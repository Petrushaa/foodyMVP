# Django
DJANGO_SECRET_KEY=<random-string-50-chars>
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,backend
CORS_ALLOWED_ORIGINS=http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=<strong-password>

# PostgreSQL (должны совпадать с postgres_env)
POSTGRES_DB=foody
POSTGRES_USER=foody
POSTGRES_PASSWORD=<db-password>
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (кэш + брокер Celery)
REDIS_URL=redis://redis:6379/0

# ── Почта (smtp.bz) ──
# Логин и пароль — из панели smtp.bz. Логин к отправителю отношения не имеет:
# DEFAULT_FROM_EMAIL обязан быть на домене, подтверждённом в smtp.bz, иначе
# релей отвечает «Domain not verified» и письмо не уходит.
# Порт 587 со STARTTLS; если хостер режет его, у smtp.bz есть 2525.
# Без EMAIL_HOST письма не отправляются: EMAIL_FILE_PATH складывает их
# файлами в папку, а без него — печатает в лог. Это режимы разработки.
EMAIL_HOST=connect.smtp.bz
EMAIL_PORT=587
EMAIL_HOST_USER=<логин-из-панели-smtp.bz>
# EMAIL_FILE_PATH=/app/.dev-mail   # только для разработки
EMAIL_HOST_PASSWORD=<ключ-smtp>
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=Foody <noreply@foody.press>

# Коды из писем: срок жизни, лимит попыток ввода, пауза между письмами
EMAIL_CODE_TTL=15m
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_RESEND_COOLDOWN=60s

# Чистка: сколько держать отработавшие коды и через сколько удалять
# регистрации, которые не довели до конца (такая запись держит чужой адрес —
# email уникален). Периодичность самой задачи — CLEANUP_INTERVAL.
EMAIL_CODE_RETENTION=2d
UNVERIFIED_ACCOUNT_TTL=7d
CLEANUP_INTERVAL=24h
