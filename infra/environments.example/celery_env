# Celery-контейнеры запускают тот же Django-проект, поэтому им нужны
# те же настройки БД/Redis, что и бэкенду.

# Django
DJANGO_SECRET_KEY=<random-string-50-chars>
DJANGO_DEBUG=0

# PostgreSQL (должны совпадать с postgres_env)
POSTGRES_DB=foody
POSTGRES_USER=foody
POSTGRES_PASSWORD=<db-password>
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (брокер и бэкенд результатов Celery)
REDIS_URL=redis://redis:6379/0

# Периодичность задачи пересчёта статистики: '10s', '1m', '1h'
UPDATE_STATS_INTERVAL=1m

# ── Почта (smtp.bz) ──
# Письма отправляет именно этот контейнер, поэтому настройки нужны и здесь.
# DEFAULT_FROM_EMAIL обязан быть на домене, подтверждённом в smtp.bz.
EMAIL_HOST=connect.smtp.bz
EMAIL_PORT=587
EMAIL_HOST_USER=<логин-из-панели-smtp.bz>
EMAIL_HOST_PASSWORD=<ключ-smtp>
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=Foody <noreply@foody.press>

# Коды из писем: срок жизни, лимит попыток ввода, пауза между письмами
EMAIL_CODE_TTL=15m
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_RESEND_COOLDOWN=60s
